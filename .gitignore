# Unity generates these folders/files automatically. They are either huge,
# machine-specific, or fully reconstructible from Assets/ + ProjectSettings/,
# so they don't belong in git. Based on GitHub's official Unity.gitignore template.

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE / tooling
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash / debug artifacts
sysinfo.txt
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Build outputs
*.apk
*.aab
*.unitypackage
*.app

# OS noise
.DS_Store
Thumbs.db
